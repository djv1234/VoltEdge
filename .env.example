# Copy this file to .env and fill in the values. Never commit .env.

# Supabase project URL, for example https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Supabase secret key (service role). Server-side only. Leave both values empty
# to run on the local SQLite fallback.
SUPABASE_KEY=

# Optional: path of the local SQLite fallback database.
VOLTEDGE_SQLITE_PATH=voltedge_local.db

# Optional: where the Streamlit dashboard finds the API.
VOLTEDGE_API_URL=http://localhost:8000
