# Copy this file to .env and fill in the values. Never commit .env.

# Supabase project URL, for example https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Supabase secret key (service role). Server-side only. Leave both values empty
# to run on the local SQLite fallback.
SUPABASE_KEY=

# Optional: path of the local SQLite fallback database.
VOLTEDGE_SQLITE_PATH=voltedge_local.db

# Optional: where the Streamlit dashboard finds the API.
VOLTEDGE_API_URL=http://localhost:8000

# Optional: free EIA Open Data API key (https://www.eia.gov/opendata/register.php).
# When set, VoltEdge uses live data for CAISO: day-ahead prices from CAISO and
# carbon intensity calculated from the EIA fuel mix. Leave empty for simulation.
EIA_API_KEY=

# Optional: "simulation" forces the simulation even when EIA_API_KEY is set.
VOLTEDGE_GRID_SOURCE=auto

# Optional: how many hours of each 24-hour window count as stressed (4 to 6).
VOLTEDGE_STRESSED_HOURS=5

# Optional: CAISO pricing node. Default is the SP15 trading hub.
VOLTEDGE_CAISO_NODE=TH_SP15_GEN-APND
